def scaffold (dir : System.FilePath) : IO Unit := do
  if ← dir.pathExists then
    if !(← dir.readDir).isEmpty then
      throw <| IO.userError s!"{dir} exists and is not empty"
  for (rel, body) in starter do
    let p := dir / rel
    if let some d := p.parent then IO.FS.createDirAll d
    IO.FS.writeFile p body
  IO.println s!"created {dir}/ — next: static_site serve {dir}"

def main (argv : List String) : IO UInt32 := do
  let a := parseArgs argv {}
  if a.src.isEmpty || !["new", "build", "serve"].contains a.cmd then
    IO.eprintln "usage: static_site new|build|serve <dir> [--out DIR] [--title T] [--base-url URL] [--port N] [--drafts]"
    return 2
  if a.cmd == "new" then
    scaffold a.src
    return 0
  let cfg : Site.Config := {
    srcDir := a.src, outDir := a.out?.getD "_site", siteTitle := a.title,
    tagline := a.tagline, baseUrl := a.baseUrl, includeDrafts := a.drafts }
  if a.cmd == "serve" then
    Site.serve cfg a.port
    return 0
  let r ← Site.build cfg
  IO.println s!"static_site: {r.pages.length} pages + {r.assets} assets → {cfg.outDir}/"
  return 0

end StaticSite

def main (argv : List String) : IO UInt32 := StaticSite.main argv
