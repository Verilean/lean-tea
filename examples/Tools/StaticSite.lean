import LeanTea
import LeanTea.Site

/-! # static_site — build, serve or scaffold a static site

```
$ static_site new mysite                       # scaffold a starter site
$ static_site build mysite [--out _site] [--title "My site"] [--base-url https://…] [--drafts]
$ static_site serve mysite [--out _site] [--port 8080]   # rebuilds on change
```

See `LeanTea.Site` for the source layout and template bindings. -/

open LeanTea

namespace StaticSite

structure Args where
  cmd     : String := ""
  src     : String := ""
  out?    : Option String := none
  title   : String := "Site"
  tagline : String := ""
  baseUrl : String := ""
  port    : UInt16 := 8080
  drafts  : Bool := false

partial def parseArgs : List String → Args → Args
  | "--out" :: v :: r, a      => parseArgs r { a with out? := some v }
  | "--title" :: v :: r, a    => parseArgs r { a with title := v }
  | "--tagline" :: v :: r, a  => parseArgs r { a with tagline := v }
  | "--base-url" :: v :: r, a => parseArgs r { a with baseUrl := v }
  | "--port" :: v :: r, a     => parseArgs r { a with port := (v.toNat?.getD 8080).toUInt16 }
  | "--drafts" :: r, a        => parseArgs r { a with drafts := true }
  | x :: r, a =>
    if a.cmd.isEmpty then parseArgs r { a with cmd := x }
    else if a.src.isEmpty then parseArgs r { a with src := x }
    else parseArgs r a
  | [], a => a

/-! ## Scaffold -/

