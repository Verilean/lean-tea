-- examples/Breezehollow/World.leanjs — the whole game client, in LeanJs.
--
-- An anime-style open-world vignette on three.js: cel-shaded hills,
-- a lake, floating islands, a wind shrine, collectible motes and
-- monsters. You run, sprint, jump, glide on updrafts, fly, use a wind
-- skill and fight with wind.
--
-- Served by examples/Breezehollow/Serve.lean, which parses this file
-- with LeanJs.Parser, checks it (arity / records) and compiles it to an
-- ES module at startup (`--dev` recompiles on every request). The world
-- is generated here from primitives, without textures; the heroine is a
-- glTF model put together in Blender (tools/heroine-vrm/).
--
-- Controls: WASD move · Shift sprint · Space jump / glide · Q fly (Space
-- up, C down, Shift boost) · click attack (a wind bolt in flight) · E wind
-- skill · F attune shrine · T return to shrine · mouse look · wheel zoom.
-- Add `?low` to the URL on a slow GPU.

import * as THREE from "three"
import { EffectComposer } from "three/addons/postprocessing/EffectComposer.js"
import { RenderPass } from "three/addons/postprocessing/RenderPass.js"
import { UnrealBloomPass } from "three/addons/postprocessing/UnrealBloomPass.js"
import { OutputPass } from "three/addons/postprocessing/OutputPass.js"
import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js"

-- ───────────────────────── host primitives ─────────────────────────

extern js "globalThis.document" doc
extern js "globalThis.window" win
extern js "(a, b, s) => { const r = []; for (let i = a; i < b; i += s) r.push(i); return r; }" range
extern js "(arr, v) => { arr.push(v); return arr; }" push
extern js "(x, a, b) => Math.min(b, Math.max(a, x))" clamp
extern js "(a, b, t) => a + (b - a) * t" lerp
extern js "(x) => x - Math.floor(x)" fract
extern js "(f) => requestAnimationFrame(f)" raf
extern js "() => performance.now() / 1000" now
extern js "(id) => document.getElementById(id)" byId
extern js "(el, t) => { if (el.textContent !== t) el.textContent = t; }" setText
extern js "(el, k, v) => el.style.setProperty(k, v)" setStyle
extern js "(el, c, on) => el.classList.toggle(c, on)" toggleClass
extern js "(el, ev, f) => el.addEventListener(ev, f, { passive: false })" listen
extern js "(n) => n.toFixed(0)" fmt0
extern js "(el) => { try { const p = el.requestPointerLock && el.requestPointerLock(); if (p && p.catch) p.catch(() => {}); } catch (e) {} }" lockPointer

def PI := Math.PI
def TAU := Math.PI * 2

def smoothstep(e0, e1, x) :=
  let t := clamp((x - e0) / (e1 - e0), 0, 1);
  t * t * (3 - 2 * t)

-- ───────────────────────── terrain (pure) ─────────────────────────
-- The same height function builds the mesh, drives collision, places
-- props and paints the minimap.

def hash2(x, z) := fract(Math.sin(x * 127.1 + z * 311.7) * 43758.5453)

def vnoise(x, z) :=
  let ix := Math.floor(x);
  let iz := Math.floor(z);
  let ux := smoothstep(0, 1, x - ix);
  let uz := smoothstep(0, 1, z - iz);
  lerp(lerp(hash2(ix, iz), hash2(ix + 1, iz), ux),
       lerp(hash2(ix, iz + 1), hash2(ix + 1, iz + 1), ux), uz)

def fbm(x, z) :=
  vnoise(x, z) * 0.5 + vnoise(x * 2.03 + 17, z * 2.03 + 9) * 0.25 +
  vnoise(x * 4.11 + 3, z * 4.11 + 41) * 0.125

def LAKE_X := 70
def LAKE_Z := -55
def WORLD_R := 235

def heightAt(x, z) :=
  let d := Math.sqrt(x * x + z * z);
  let hills := (fbm(x * 0.016, z * 0.016) - 0.35) * 22;
  let near := smoothstep(10, 45, d);
  let ridge := smoothstep(150, 225, d) * (fbm(x * 0.012 + 7, z * 0.012 + 3) * 75 + 25);
  let ld := Math.sqrt((x - LAKE_X) * (x - LAKE_X) + (z - LAKE_Z) * (z - LAKE_Z));
  let lake := (1 - smoothstep(8, 42, ld)) * 10;
  hills * (0.25 + 0.75 * near) + ridge - lake + 2.6

def WATER_Y := 0

-- Terrain colour by height + a little noise: sand, two greens, rock, snow.
def terrainColor(x, y, z) :=
  let n := fbm(x * 0.05 + 100, z * 0.05);
  if y < WATER_Y + 0.7 then [0.93, 0.86, 0.62]
  else if y < 16 then
    (if n > 0.5 then [0.42, 0.74, 0.30] else [0.53, 0.82, 0.34])
  else if y < 28 then [0.40, 0.66, 0.38]
  else if y < 52 then (if n > 0.45 then [0.50, 0.55, 0.72] else [0.58, 0.62, 0.78])
  else [0.96, 0.97, 1.0]

-- ───────────────────────── renderer + scene ─────────────────────────

-- `?low` in the URL: a lighter world for slow GPUs (and software
-- rendering): less grass, no shadows, no bloom, one pixel per pixel.
def LOW := win.location.search.includes("low")

def canvas := byId("world")
def renderer := new THREE.WebGLRenderer({canvas: canvas, antialias: true})
def scene := new THREE.Scene()
def camera := new THREE.PerspectiveCamera(55, 1, 0.1, 1200)
def FOG_COLOR := 0xcde8ff

def setupRenderer() := do
  renderer.setPixelRatio(if LOW then 1 else Math.min(win.devicePixelRatio, 2));
  renderer.shadowMap.enabled := !LOW;
  renderer.shadowMap.type := THREE.PCFSoftShadowMap;
  scene.fog := new THREE.Fog(FOG_COLOR, 140, 520);
  scene.background := new THREE.Color(FOG_COLOR);
  null

-- Three-step light ramp: the cel-shading look.
def toonRamp := do
  let data := new Uint8Array([140, 205, 255]);
  let t := new THREE.DataTexture(data, 3, 1, THREE.RedFormat);
  t.minFilter := THREE.NearestFilter;
  t.magFilter := THREE.NearestFilter;
  t.needsUpdate := true;
  t

def toon(color) := new THREE.MeshToonMaterial({color: color, gradientMap: toonRamp})
def OUTLINE := new THREE.MeshBasicMaterial({color: 0x2a2440, side: THREE.BackSide})

-- A mesh plus an inverted-hull outline (a slightly larger back-face copy).
def outlined(geo, color, thick) := do
  let g := new THREE.Group();
  let body := new THREE.Mesh(geo, toon(color));
  body.castShadow := true;
  body.receiveShadow := true;
  let hull := new THREE.Mesh(geo, OUTLINE);
  hull.scale.setScalar(thick);
  g.add(body);
  g.add(hull);
  g

def placed(obj, x, y, z) := do
  obj.position.set(x, y, z);
  scene.add(obj);
  obj

-- ───────────────────────── sky, sun, clouds ─────────────────────────

def SKY_VS := "
varying vec3 vDir;
void main() {
  vDir = normalize(position);
  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
}"

def SKY_FS := "
uniform vec3 uSun;
varying vec3 vDir;
void main() {
  float h = clamp(vDir.y, -0.2, 1.0);
  vec3 top = vec3(0.16, 0.45, 0.92);
  vec3 mid = vec3(0.45, 0.72, 1.0);
  vec3 hor = vec3(0.80, 0.91, 1.0);
  vec3 col = mix(hor, mid, smoothstep(0.0, 0.25, h));
  col = mix(col, top, smoothstep(0.25, 0.9, h));
  float s = max(dot(normalize(vDir), uSun), 0.0);
  col += vec3(1.0, 0.95, 0.8) * (pow(s, 600.0) * 3.0 + pow(s, 12.0) * 0.25);
  gl_FragColor = vec4(pow(col, vec3(2.2)), 1.0);
}"

def SUN_DIR := do
  let v := new THREE.Vector3(0.5, 0.75, 0.35);
  v.normalize();
  v

def buildSky() := do
  let mat := new THREE.ShaderMaterial({
    vertexShader: SKY_VS, fragmentShader: SKY_FS, side: THREE.BackSide,
    depthWrite: false, fog: false, uniforms: {uSun: {value: SUN_DIR}}});
  let sky := new THREE.Mesh(new THREE.SphereGeometry(900, 32, 16), mat);
  scene.add(sky);
  sky

def sun := new THREE.DirectionalLight(0xfff4e0, 2.4)
def hemi := new THREE.HemisphereLight(0xd6ecff, 0x7fa25a, 1.25)

def setupLights() := do
  sun.castShadow := true;
  sun.shadow.mapSize.set(2048, 2048);
  let sc := sun.shadow.camera;
  sc.left := -45; sc.right := 45; sc.top := 45; sc.bottom := -45;
  sc.near := 1; sc.far := 200;
  sun.shadow.bias := -0.0006;
  scene.add(sun);
  scene.add(sun.target);
  scene.add(hemi);
  null

def CLOUD := new THREE.MeshToonMaterial({color: 0xffffff, gradientMap: toonRamp, emissive: 0x3a4a5e})
def clouds := []

def buildClouds() := do
  for i in range(0, 26, 1) do (
    let g := new THREE.Group();
    let a := hash2(i, 3) * TAU;
    let r := 120 + hash2(i, 5) * 300;
    for k in range(0, 6, 1) do (
      let s := 9 + hash2(i, k) * 12;
      let puff := new THREE.Mesh(new THREE.SphereGeometry(s, 12, 8), CLOUD);
      puff.position.set((k - 2.5) * 10 + hash2(k, i) * 6, hash2(i + k, 1) * 5, hash2(k, i + 7) * 12);
      puff.scale.y := 0.55;
      g.add(puff)
    );
    g.position.set(Math.cos(a) * r, 95 + hash2(i, 9) * 50, Math.sin(a) * r);
    scene.add(g);
    push(clouds, g)
  );
  null

-- ───────────────────────── ground + water ─────────────────────────

def buildTerrain() := do
  let size := 520;
  let seg := 200;
  let geo := new THREE.PlaneGeometry(size, size, seg, seg);
  geo.rotateX(-PI / 2);
  let pos := geo.attributes.position;
  let colors := new Float32Array(pos.count * 3);
  for i in range(0, pos.count, 1) do (
    let x := pos.getX(i);
    let z := pos.getZ(i);
    let y := heightAt(x, z);
    pos.setY(i, y);
    let c := terrainColor(x, y, z);
    colors[i * 3] := c[0];
    colors[i * 3 + 1] := c[1];
    colors[i * 3 + 2] := c[2]
  );
  geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));
  geo.computeVertexNormals();
  let mat := new THREE.MeshToonMaterial({vertexColors: true, gradientMap: toonRamp});
  let mesh := new THREE.Mesh(geo, mat);
  mesh.receiveShadow := true;
  scene.add(mesh);
  mesh

def water := new THREE.Mesh(
  new THREE.PlaneGeometry(520, 520, 1, 1),
  new THREE.MeshPhongMaterial({color: 0x39b6e8, transparent: true, opacity: 0.78,
                               shininess: 120, specular: 0xffffff}))

def buildWater() := do
  water.rotation.x := -PI / 2;
  water.position.y := WATER_Y;
  scene.add(water);
  water

-- ───────────────────────── grass (instanced, wind shader) ─────────────────────────

def GRASS_VS := "
uniform float uTime;
varying float vH;
varying float vDist;
varying float vTone;
void main() {
  vec4 wp = modelMatrix * instanceMatrix * vec4(position, 1.0);
  float h = position.y;
  float gust = sin(uTime * 1.7 + wp.x * 0.07 + wp.z * 0.05) * 0.5 + 0.5;
  float w = (sin(uTime * 2.6 + wp.x * 0.35 + wp.z * 0.21) * 0.25 + gust * 0.45) * h * h;
  wp.x += w;
  wp.z += w * 0.6;
  vH = h;
  vTone = fract(sin(dot(instanceMatrix[3].xz, vec2(12.9898, 78.233))) * 43758.5453);
  vec4 mv = viewMatrix * wp;
  vDist = -mv.z;
  gl_Position = projectionMatrix * mv;
}"

def GRASS_FS := "
uniform vec3 uFog;
varying float vH;
varying float vDist;
varying float vTone;
void main() {
  vec3 base = vec3(0.20, 0.47, 0.17);
  vec3 tip = mix(vec3(0.62, 0.90, 0.38), vec3(0.80, 0.92, 0.42), vTone);
  vec3 col = mix(base, tip, smoothstep(0.0, 1.0, vH));
  col = pow(col, vec3(2.2));
  col = mix(col, uFog, smoothstep(140.0, 520.0, vDist));
  gl_FragColor = vec4(col, 1.0);
}"

def grassMat := new THREE.ShaderMaterial({
  vertexShader: GRASS_VS, fragmentShader: GRASS_FS, side: THREE.DoubleSide,
  uniforms: {uTime: {value: 0}, uFog: {value: new THREE.Color(FOG_COLOR)}}})

def bladeGeo() := do
  let g := new THREE.BufferGeometry();
  let v := new Float32Array([-0.07, 0, 0,  0.07, 0, 0,  0, 1, 0]);
  g.setAttribute("position", new THREE.BufferAttribute(v, 3));
  g

def buildGrass(count) := do
  let mesh := new THREE.InstancedMesh(bladeGeo(), grassMat, count);
  let m := new THREE.Matrix4();
  let q := new THREE.Quaternion();
  let s := new THREE.Vector3();
  let p := new THREE.Vector3();
  let up := new THREE.Vector3(0, 1, 0);
  let mut n := 0;
  let mut tries := 0;
  while n < count && tries < count * 4 do (
    tries := tries + 1;
    let r := Math.sqrt(Math.random()) * 120;
    let a := Math.random() * TAU;
    let x := Math.cos(a) * r;
    let z := Math.sin(a) * r;
    let y := heightAt(x, z);
    if y > WATER_Y + 1 && y < 15 then (
      p.set(x, y - 0.05, z);
      q.setFromAxisAngle(up, Math.random() * TAU);
      let h := 0.35 + Math.random() * 0.55;
      s.set(1.4, h, 1.4);
      m.compose(p, q, s);
      mesh.setMatrixAt(n, m);
      n := n + 1)
  );
  mesh.count := n;
  mesh.frustumCulled := false;
  scene.add(mesh);
  mesh

-- Little flowers: instanced spheres in a few anime-bright colours.
def buildFlowers(count) := do
  let colors := [0xff7eb6, 0xfff275, 0xffffff, 0x9ad0ff];
  for ci in range(0, 4, 1) do (
    let mesh := new THREE.InstancedMesh(new THREE.IcosahedronGeometry(0.16, 0),
                                        toon(colors[ci]), count);
    let m := new THREE.Matrix4();
    for k in range(0, count, 1) do (
      let r := Math.sqrt(Math.random()) * 110;
      let a := Math.random() * TAU;
      let x := Math.cos(a) * r;
      let z := Math.sin(a) * r;
      let y := heightAt(x, z);
      m.makeTranslation(x, (if y > WATER_Y + 1 && y < 14 then y + 0.35 else -50), z);
      mesh.setMatrixAt(k, m)
    );
    scene.add(mesh)
  );
  null

-- ───────────────────────── props: trees, rocks, islands ─────────────────────────

-- Spawn point and shrine stay clear of trees and rocks.
def clearing(x, z) :=
  Math.hypot(x, z - 30) < 14 || Math.hypot(x + 14, z - 18) < 9

-- Colliders: {x, z, r} cylinders you can't walk through.
def colliders := []
-- Platforms: {x, z, r, top} flat tops you can stand on.
def platforms := []

def makeTree(x, z, scale) := do
  let y := heightAt(x, z);
  let t := new THREE.Group();
  let trunk := outlined(new THREE.CylinderGeometry(0.35 * scale, 0.5 * scale, 3.2 * scale, 7), 0x8a5a3b, 1.08);
  trunk.position.y := 1.6 * scale;
  t.add(trunk);
  let shades := [0x3f9e4a, 0x52b45a, 0x6cc96a];
  for k in range(0, 3, 1) do (
    let r := (2.6 - k * 0.6) * scale;
    let crown := outlined(new THREE.IcosahedronGeometry(r, 0), shades[k], 1.06);
    crown.position.set(0, (3.4 + k * 1.5) * scale, 0);
    crown.rotation.y := k * 0.7;
    t.add(crown)
  );
  placed(t, x, y - 0.2, z);
  push(colliders, {x: x, z: z, r: 0.7 * scale})

def makeRock(x, z, scale) := do
  let y := heightAt(x, z);
  let rock := outlined(new THREE.DodecahedronGeometry(scale, 0), 0x9aa0a8, 1.05);
  rock.rotation.set(hash2(x, z) * 3, hash2(z, x) * 3, 0);
  rock.scale.y := 0.7;
  placed(rock, x, y + scale * 0.25, z);
  push(colliders, {x: x, z: z, r: scale * 0.9})

def buildForest() := do
  let mut placedN := 0;
  for i in range(0, 900, 1) do (
    let a := hash2(i, 11) * TAU;
    let r := 18 + hash2(i, 13) * 170;
    let x := Math.cos(a) * r;
    let z := Math.sin(a) * r;
    let y := heightAt(x, z);
    let clump := fbm(x * 0.03 + 50, z * 0.03);
    if placedN < 150 && y > WATER_Y + 1.2 && y < 14 && clump > 0.48 && !clearing(x, z) then (
      makeTree(x, z, 0.8 + hash2(i, 17) * 0.7);
      placedN := placedN + 1)
  );
  for i in range(0, 60, 1) do (
    let a := hash2(i, 21) * TAU;
    let r := 15 + hash2(i, 23) * 180;
    let x := Math.cos(a) * r;
    let z := Math.sin(a) * r;
    if heightAt(x, z) > WATER_Y + 0.5 && !clearing(x, z) then makeRock(x, z, 0.6 + hash2(i, 27) * 1.6)
  );
  null

-- Floating islands: a grassy disc on an upside-down rocky cone.
def ISLANDS := [
  {x: -38, z: -30, r: 7, top: 22},
  {x: -60, z: 10, r: 6, top: 34},
  {x: 30, z: 48, r: 8, top: 27},
  {x: 5, z: -95, r: 7, top: 40},
  {x: 95, z: 25, r: 6, top: 31}
]

def buildIslands() := do
  for isl in ISLANDS do (
    let g := new THREE.Group();
    let top := outlined(new THREE.CylinderGeometry(isl.r, isl.r * 0.92, 1.4, 14), 0x5cc15a, 1.03);
    g.add(top);
    let cone := outlined(new THREE.ConeGeometry(isl.r * 0.9, isl.r * 1.8, 9), 0x8f8578, 1.03);
    cone.rotation.x := PI;
    cone.position.y := -isl.r * 0.9 - 0.7;
    g.add(cone);
    placed(g, isl.x, isl.top - 0.7, isl.z);
    push(platforms, isl)
  );
  null

-- ───────────────────────── shrine, motes, updrafts ─────────────────────────

def SHRINE := {x: -14, z: 18, attuned: false}
def shrineGem := new THREE.Mesh(new THREE.OctahedronGeometry(1.1, 0),
  new THREE.MeshStandardMaterial({color: 0x7ff3ff, emissive: 0x3fe3ff, emissiveIntensity: 2.2}))
def shrineBeam := new THREE.Mesh(new THREE.CylinderGeometry(0.9, 0.9, 120, 16, 1, true),
  new THREE.MeshBasicMaterial({color: 0xffe28a, transparent: true, opacity: 0.0,
                               blending: THREE.AdditiveBlending, depthWrite: false}))

def buildShrine() := do
  let y := heightAt(SHRINE.x, SHRINE.z);
  let g := new THREE.Group();
  let base := outlined(new THREE.CylinderGeometry(2.6, 3.0, 0.8, 8), 0xd9d4c7, 1.04);
  base.position.y := 0.4;
  g.add(base);
  let pillar := outlined(new THREE.CylinderGeometry(0.55, 0.75, 4.2, 8), 0xe9e4d6, 1.06);
  pillar.position.y := 2.9;
  g.add(pillar);
  let ring := new THREE.Mesh(new THREE.TorusGeometry(1.7, 0.09, 8, 40), toon(0xc9a84a));
  ring.position.y := 6.4;
  ring.rotation.x := PI / 2;
  g.add(ring);
  shrineGem.position.y := 6.4;
  g.add(shrineGem);
  shrineBeam.position.y := 66;
  g.add(shrineBeam);
  placed(g, SHRINE.x, y - 0.1, SHRINE.z);
  push(colliders, {x: SHRINE.x, z: SHRINE.z, r: 2.6})

def motes := []
def MOTE_SPOTS := [
  [6, 26], [-25, -8], [40, 12], [-38, -30], [-60, 10], [30, 48], [5, -95], [95, 25],
  [70, -55], [-90, -60], [-120, 40], [140, -10], [10, 150], [-30, 120]
]

-- Mote height: above an island when one is there, else floating over ground.
def moteY(x, z) := do
  let mut y := Math.max(heightAt(x, z), WATER_Y) + 2.2;
  for isl in ISLANDS do (
    if Math.hypot(x - isl.x, z - isl.z) < isl.r then (y := isl.top + 1.8)
  );
  y

def buildMotes() := do
  let geo := new THREE.OctahedronGeometry(0.45, 0);
  for spot in MOTE_SPOTS do (
    let mat := new THREE.MeshStandardMaterial({color: 0xa8fff0, emissive: 0x52ffd8, emissiveIntensity: 2.5});
    let mesh := new THREE.Mesh(geo, mat);
    let y := moteY(spot[0], spot[1]);
    placed(mesh, spot[0], y, spot[1]);
    let halo := new THREE.Mesh(new THREE.TorusGeometry(0.75, 0.04, 6, 24),
      new THREE.MeshBasicMaterial({color: 0xb8fff4, transparent: true, opacity: 0.7}));
    mesh.add(halo);
    push(motes, {mesh: mesh, halo: halo, x: spot[0], y: y, z: spot[1], got: false})
  );
  null

-- Updraft columns: glide into one to be carried up.
def UPDRAFTS := [
  {x: -30, z: -22, r: 5.5, top: 46},
  {x: 22, z: 40, r: 5.5, top: 48},
  {x: 0, z: -80, r: 5.5, top: 56},
  {x: 85, z: 30, r: 5.0, top: 50}
]
def draftParts := []

def buildUpdrafts() := do
  for d in UPDRAFTS do (
    let n := 140;
    let geo := new THREE.BufferGeometry();
    let pos := new Float32Array(n * 3);
    let seeds := new Float32Array(n * 3);
    for k in range(0, n, 1) do (
      seeds[k * 3] := Math.random() * TAU;
      seeds[k * 3 + 1] := Math.random();
      seeds[k * 3 + 2] := 0.4 + Math.random() * 0.6
    );
    geo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
    let mat := new THREE.PointsMaterial({color: 0xd8fff6, size: 0.5, map: dotTexture, transparent: true, opacity: 0.85,
                                         blending: THREE.AdditiveBlending, depthWrite: false});
    let pts := new THREE.Points(geo, mat);
    pts.frustumCulled := false;
    scene.add(pts);
    let base := Math.max(heightAt(d.x, d.z), WATER_Y);
    push(draftParts, {d: d, geo: geo, seeds: seeds, n: n, base: base})
  );
  null

def updateUpdrafts(t) := do
  for u in draftParts do (
    let arr := u.geo.attributes.position.array;
    let h := u.d.top - u.base;
    for k in range(0, u.n, 1) do (
      let a := u.seeds[k * 3] + t * 1.6 * u.seeds[k * 3 + 2];
      let f := fract(u.seeds[k * 3 + 1] + t * 0.18 * u.seeds[k * 3 + 2]);
      let rr := u.d.r * (0.35 + 0.65 * u.seeds[k * 3 + 2]);
      arr[k * 3] := u.d.x + Math.cos(a) * rr;
      arr[k * 3 + 1] := u.base + f * h;
      arr[k * 3 + 2] := u.d.z + Math.sin(a) * rr
    );
    u.geo.attributes.position.needsUpdate := true
  );
  null

-- ───────────────────────── sparkle particles ─────────────────────────

-- Soft round sprite for every particle system (points are squares otherwise).
def dotTexture := do
  let c := doc.createElement("canvas");
  c.width := 64;
  c.height := 64;
  let ctx := c.getContext("2d");
  let g := ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
  g.addColorStop(0, "rgba(255,255,255,1)");
  g.addColorStop(0.35, "rgba(255,255,255,0.85)");
  g.addColorStop(1, "rgba(255,255,255,0)");
  ctx.fillStyle := g;
  ctx.fillRect(0, 0, 64, 64);
  new THREE.CanvasTexture(c)

def SPARK_N := 600
def sparkGeo := new THREE.BufferGeometry()
def sparkPos := new Float32Array(SPARK_N * 3)
def sparkVel := new Float32Array(SPARK_N * 3)
def sparkLife := new Float32Array(SPARK_N)
def sparks := { next: 0 }

def buildSparks() := do
  for k in range(0, SPARK_N, 1) do (sparkPos[k * 3 + 1] := -999);
  sparkGeo.setAttribute("position", new THREE.BufferAttribute(sparkPos, 3));
  let mat := new THREE.PointsMaterial({color: 0xbfffee, size: 0.45, map: dotTexture, transparent: true,
                                       blending: THREE.AdditiveBlending, depthWrite: false});
  let pts := new THREE.Points(sparkGeo, mat);
  pts.frustumCulled := false;
  scene.add(pts);
  pts

def emit(x, y, z, vx, vy, vz, life) := do
  let k := sparks.next;
  sparks.next := (k + 1) % SPARK_N;
  sparkPos[k * 3] := x; sparkPos[k * 3 + 1] := y; sparkPos[k * 3 + 2] := z;
  sparkVel[k * 3] := vx; sparkVel[k * 3 + 1] := vy; sparkVel[k * 3 + 2] := vz;
  sparkLife[k] := life;
  null

def burst(x, y, z, n, speed) := do
  for k in range(0, n, 1) do (
    let a := Math.random() * TAU;
    let e := Math.random() * 2 - 1;
    let s := speed * (0.4 + Math.random() * 0.6);
    let c := Math.sqrt(1 - e * e);
    emit(x, y, z, Math.cos(a) * c * s, e * s + 2, Math.sin(a) * c * s, 0.7 + Math.random() * 0.6)
  );
  null

-- Flat expanding ring (the wind skill).
def ringBurst(x, y, z, n, speed) := do
  for k in range(0, n, 1) do (
    let a := k / n * TAU;
    emit(x + Math.cos(a) * 0.8, y + 0.3, z + Math.sin(a) * 0.8,
         Math.cos(a) * speed, 1.5 + Math.random() * 2, Math.sin(a) * speed, 0.6 + Math.random() * 0.3)
  );
  null

def updateSparks(dt) := do
  for k in range(0, SPARK_N, 1) do (
    if sparkLife[k] > 0 then (
      sparkLife[k] := sparkLife[k] - dt;
      sparkVel[k * 3 + 1] := sparkVel[k * 3 + 1] - 3 * dt;
      sparkPos[k * 3] := sparkPos[k * 3] + sparkVel[k * 3] * dt;
      sparkPos[k * 3 + 1] := (if sparkLife[k] > 0 then sparkPos[k * 3 + 1] + sparkVel[k * 3 + 1] * dt else -999);
      sparkPos[k * 3 + 2] := sparkPos[k * 3 + 2] + sparkVel[k * 3 + 2] * dt)
  );
  sparkGeo.attributes.position.needsUpdate := true;
  null

-- ───────────────────────── the heroine ─────────────────────────
-- Put together in Blender from two freely licensed sample avatars
-- (tools/heroine-vrm/) and given tools/blender/heroine.py's skeleton:
-- examples/Breezehollow/heroine.glb, which the server serves as
-- /heroine.glb. It is a set of skinned meshes with idle, run, glide,
-- hover, fly and fall clips, and attack_1-3 and hurt played once. Her materials are swapped for the world's
-- toon ones, each with an outline that follows the skin, and her hair and
-- skirt are bone chains swung by springs every frame
-- (`updateSprings`).

def HERO_SCALE := 1.15
-- her hips, in metres: the pivot she leans about when gliding or flying
def HIPS := 1.0
extern js "(e) => console.error(e)" logError
-- An inverted hull that stays a constant width on a skinned mesh: push
-- each vertex out along its (unskinned) normal before skinning.
extern js "(m, w) => { m.onBeforeCompile = (sh) => { sh.vertexShader = sh.vertexShader.replace('#include <begin_vertex>', '#include <begin_vertex>' + String.fromCharCode(10) + 'transformed += normal * ' + w.toFixed(4) + ';'); }; return m; }" grownHull
-- The same for a surface cut out by its texture's alpha (hair tips, lace):
-- the hull keeps the cut-outs but not the texture's colours.
extern js "(m, w) => { m.onBeforeCompile = (sh) => { sh.vertexShader = sh.vertexShader.replace('#include <begin_vertex>', '#include <begin_vertex>' + String.fromCharCode(10) + 'transformed += normal * ' + w.toFixed(4) + ';'); sh.fragmentShader = sh.fragmentShader.replace('#include <map_fragment>', 'diffuseColor.a *= texture2D(map, vMapUv).a;'); }; return m; }" grownCutHull

-- Outlines tinted to what they go round, thinner on the face, as anime
-- toon shading draws them. (color, width)
def HULL_STYLE := {
  Face: [0x7a4a48, 0.0030], Neck: [0x7a4a48, 0.0030], Skin: [0x7a4a48, 0.0035],
  Hair: [0x6a6488, 0.0040], Default: [0x3a3058, 0.0045]}
def hullStyle(name) := if HULL_STYLE[name] then HULL_STYLE[name] else HULL_STYLE.Default
def HULLS := {}
def hullFor(name, old) := do
  let st := hullStyle(name);
  if old.alphaTest > 0 then
    grownCutHull(new THREE.MeshBasicMaterial({color: st[0], side: THREE.BackSide, map: old.map, alphaTest: old.alphaTest}), st[1])
  else (do
    if !HULLS[name] then (HULLS[name] := grownHull(new THREE.MeshBasicMaterial({color: st[0], side: THREE.BackSide}), st[1]));
    HULLS[name])

-- Rim light: a sky-tinted edge on the side away from the camera's view,
-- added after the toon lighting.
extern js "(m, color, k) => { m.onBeforeCompile = (sh) => { sh.uniforms.rimColor = { value: new THREE.Color(color).multiplyScalar(k) }; sh.fragmentShader = 'uniform vec3 rimColor;' + String.fromCharCode(10) + sh.fragmentShader.replace('#include <opaque_fragment>', 'float rimF = 1.0 - max(dot(normalize(vViewPosition), normal), 0.0); outgoingLight += rimColor * smoothstep(0.62, 0.92, rimF);' + String.fromCharCode(10) + '#include <opaque_fragment>'); }; return m; }" rimLit

def hero := do
  let root := new THREE.Group();
  let pivot := new THREE.Group();
  pivot.position.y := HIPS * HERO_SCALE;
  root.add(pivot);
  scene.add(root);
  {root: root, pivot: pivot, model: null, mixer: null, actions: {}, current: "",
   springs: [], colliders: []}

-- Materials are told apart by name, up to the first dot ("Hair.002" is
-- hair): Face, Skin, Neck, Hair, Gem, Eye (eyes, brows, lashes and mouth,
-- drawn flat with no outline), and anything else (clothes). See-through
-- surfaces get no outline either.
def dressUp(m) := do
  let old := m.material;
  let name := old.name.split(".")[0];
  let color := old.color;
  let map := old.map;
  let cut := {map: map, color: color, transparent: old.transparent, alphaTest: old.alphaTest, side: old.side};
  m.material := if name == "Gem" then new THREE.MeshStandardMaterial({color: color, emissive: color, emissiveIntensity: 1.4})
                else if name == "Eye" then new THREE.MeshBasicMaterial(cut)
                else rimLit(new THREE.MeshToonMaterial({ cut with gradientMap := toonRamp }), 0xcfe6ff,
                            (if name == "Face" || name == "Neck" then 0.25 else 0.45));
  -- warm the shadows on skin; the painted face keeps its own colours
  if name == "Skin" || name == "Neck" then m.material.emissive.set(0x3a2420);
  if name == "Face" then (
    m.material.emissive.set(0x5a5a5a);
    m.material.emissiveMap := map);
  m.castShadow := name != "Eye";
  m.receiveShadow := false;
  -- skinned bounds don't follow the animation
  m.frustumCulled := false;
  if name != "Gem" && name != "Eye" && !(old.transparent && old.alphaTest == 0) then (
    let hull := new THREE.SkinnedMesh(m.geometry, hullFor(name, old));
    hull.bind(m.skeleton, m.bindMatrix);
    hull.frustumCulled := false;
    m.add(hull));
  null

-- Spring chains: bones `<name>_0` … `<name>_<n>` (the last is a tip).
-- stiff pulls a bone back to its rest direction, drag damps it, grav
-- pulls it down; r is the bone's thickness against the colliders.
def CHAINS := [
  {name: "hair_C", n: 4, stiff: 0.8, drag: 0.30, grav: 0.6, r: 0.025},
  {name: "hair_L", n: 4, stiff: 0.8, drag: 0.30, grav: 0.6, r: 0.025},
  {name: "hair_R", n: 4, stiff: 0.8, drag: 0.30, grav: 0.6, r: 0.025},
  {name: "lock_L", n: 3, stiff: 1.3, drag: 0.40, grav: 0.4, r: 0.02},
  {name: "lock_R", n: 3, stiff: 1.3, drag: 0.40, grav: 0.4, r: 0.02},
  {name: "coat_FL", n: 3, stiff: 1.5, drag: 0.45, grav: 0.4, r: 0.03},
  {name: "coat_BL", n: 3, stiff: 1.5, drag: 0.45, grav: 0.4, r: 0.03},
  {name: "coat_B", n: 3, stiff: 1.5, drag: 0.45, grav: 0.4, r: 0.03},
  {name: "coat_BR", n: 3, stiff: 1.5, drag: 0.45, grav: 0.4, r: 0.03},
  {name: "coat_FR", n: 3, stiff: 1.5, drag: 0.45, grav: 0.4, r: 0.03}]

-- Spheres of her body the chains can't pass through: the bone that
-- carries it, its centre in her rest pose (model space, metres), radius.
def COLLIDERS := [
  {bone: "head", at: [0, 1.69, 0], r: 0.13},
  {bone: "neck", at: [0, 1.53, 0], r: 0.055},
  {bone: "chest", at: [0.05, 1.36, 0], r: 0.09},
  {bone: "chest", at: [-0.05, 1.36, 0], r: 0.09},
  {bone: "spine", at: [0.035, 1.20, 0], r: 0.075},
  {bone: "spine", at: [-0.035, 1.20, 0], r: 0.075},
  {bone: "hips", at: [0.06, 1.04, 0], r: 0.10},
  {bone: "hips", at: [-0.06, 1.04, 0], r: 0.10},
  {bone: "thigh_L", at: [0.075, 0.88, 0], r: 0.085},
  {bone: "thigh_L", at: [0.068, 0.72, 0], r: 0.07},
  {bone: "thigh_R", at: [-0.075, 0.88, 0], r: 0.085},
  {bone: "thigh_R", at: [-0.068, 0.72, 0], r: 0.07},
  {bone: "shin_L", at: [0.056, 0.45, 0], r: 0.06},
  {bone: "shin_R", at: [-0.056, 0.45, 0], r: 0.06}]

def buildSprings(model) := do
  let bones := {};
  model.traverse(fun (o) => if o.isBone then (bones[o.name] := o));
  hero.root.updateMatrixWorld(true);
  for c in CHAINS do (
    for i in range(0, c.n, 1) do (
      let bone := bones[c.name + "_" + i];
      let child := bones[c.name + "_" + (i + 1)];
      if bone && child then (
        let head := bone.getWorldPosition(new THREE.Vector3());
        let tail := child.getWorldPosition(new THREE.Vector3());
        push(hero.springs, {bone: bone, rest: bone.quaternion.clone(),
                            toTail: child.position.clone().normalize(), len: head.distanceTo(tail),
                            tail: tail, prev: tail.clone(),
                            stiff: c.stiff, drag: c.drag, grav: c.grav, r: c.r * HERO_SCALE}))
    )
  );
  for c in COLLIDERS do (
    let bone := bones[c.bone];
    if bone then (
      let w := model.localToWorld(new THREE.Vector3(c.at[0], c.at[1], c.at[2]));
      push(hero.colliders, {bone: bone, local: bone.worldToLocal(w), r: c.r * HERO_SCALE,
                            at: new THREE.Vector3()}))
  );
  null

-- One verlet step per spring bone, root to tip: the tail keeps its
-- momentum, is pulled back toward the bone's rest direction and down,
-- stays at the bone's length and outside her body; then the bone turns
-- to point at it. `moved` is how far she moved this frame: the tails are
-- carried most of that way, so only part of her speed reads as wind.
def updateSprings(dt, moved) := do
  let carry := moved.clone().multiplyScalar(0.7);
  let teleport := moved.length() > 4;
  for c in hero.colliders do (c.at.copy(c.local).applyMatrix4(c.bone.matrixWorld));
  for s in hero.springs do (
    let head := s.bone.getWorldPosition(new THREE.Vector3());
    let parentQ := s.bone.parent.getWorldQuaternion(new THREE.Quaternion());
    let restQ := parentQ.clone().multiply(s.rest);
    let restDir := s.toTail.clone().applyQuaternion(restQ);
    if teleport then (
      s.tail.copy(head).addScaledVector(restDir, s.len);
      s.prev.copy(s.tail))
    else (
      s.tail.add(carry);
      s.prev.add(carry));
    let next := s.tail.clone().addScaledVector(s.tail.clone().sub(s.prev), 1 - s.drag);
    next.addScaledVector(restDir, s.stiff * dt);
    next.y := next.y - s.grav * dt;
    next.sub(head).normalize().multiplyScalar(s.len).add(head);
    for c in hero.colliders do (
      let d := next.clone().sub(c.at);
      let minD := c.r + s.r;
      if d.length() < minD && d.length() > 0.00001 then (
        next.copy(c.at).addScaledVector(d.normalize(), minD);
        next.sub(head).normalize().multiplyScalar(s.len).add(head))
    );
    s.prev.copy(s.tail);
    s.tail.copy(next);
    let q := new THREE.Quaternion().setFromUnitVectors(restDir, next.clone().sub(head).normalize());
    s.bone.quaternion.copy(parentQ.invert().multiply(q.multiply(restQ)));
    s.bone.updateMatrixWorld(true)
  );
  null

-- Cross-fade to the clip `name` (no-op if it is already playing).
-- Attacks and flinches play once and hold their last frame until the
-- next clip takes over.
def play(name) := do
  if hero.current != name && hero.actions[name] then (
    let next := hero.actions[name];
    let once := name != "idle" && name != "run" && name != "glide" && name != "hover" && name != "fly" && name != "fall";
    next.reset();
    if once then (
      next.setLoop(THREE.LoopOnce, 1);
      next.clampWhenFinished := true);
    let fade := if once then 0.08 else 0.25;
    next.fadeIn(fade);
    next.play();
    if hero.current != "" then hero.actions[hero.current].fadeOut(fade);
    hero.current := name);
  null

def setupHeroine(gltf) := do
  let model := gltf.scene;
  model.scale.setScalar(HERO_SCALE);
  model.position.y := -HIPS * HERO_SCALE;
  let meshes := [];
  model.traverse(fun (o) => if o.isSkinnedMesh then push(meshes, o));
  for m in meshes do (dressUp(m));
  hero.pivot.add(model);
  hero.model := model;
  let mixer := new THREE.AnimationMixer(model);
  for clip in gltf.animations do (hero.actions[clip.name] := mixer.clipAction(clip));
  hero.mixer := mixer;
  buildSprings(model);
  play("idle");
  toggleClass(byId("loading"), "hidden", true);
  null

def loadHeroine() := do
  let loader := new GLTFLoader();
  loader.load("/heroine.glb", fun (gltf) => setupHeroine(gltf), fun (e) => null, fun (e) => do
    logError(e);
    toggleClass(byId("loading"), "hidden", true);
    null);
  null

-- ───────────────────────── game state ─────────────────────────
-- The movement rules live in Physics.leanjs as a pure
-- `step(player, input, world, dt)`; this file owns everything else.

include "Physics.leanjs"

def G := {p: newPlayer(0, 4, 30), phase: 0, motes: 0, toastT: 0, hurtT: 0}
def CAM := {yaw: 0.2, pitch: 0.32, dist: 7.5, x: 0, y: 8, z: 40, dragging: false, dragged: 0}
def keys := {}
def pressed := {}

def keyDown(e) := do
  let k := e.key.toLowerCase();
  if !keys[k] then pressed[k] := true;
  keys[k] := true;
  if k == " " then e.preventDefault();
  null

def keyUp(e) := do
  keys[e.key.toLowerCase()] := false;
  null

-- Was `k` pressed since the last frame? (edge-triggered keys)
def consume(k) := do
  let was := pressed[k] == true;
  pressed[k] := false;
  was

-- Highest standing surface under (x, z) for someone at height y.
def groundAt(x, z, y) := do
  let mut g := Math.max(heightAt(x, z), WATER_Y - 0.9);
  for isl in platforms do (
    if Math.hypot(x - isl.x, z - isl.z) < isl.r && y >= isl.top - 0.6 then g := Math.max(g, isl.top)
  );
  g

def inUpdraft(x, z, y) := do
  let mut lift := 0;
  for d in UPDRAFTS do (
    if Math.hypot(x - d.x, z - d.z) < d.r && y < d.top then lift := 1
  );
  lift

-- (x, z) pushed out of every collider it overlaps, kept inside the world.
def pushOut(x, z, y) := do
  let mut px := x;
  let mut pz := z;
  for c in colliders do (
    let dx := px - c.x;
    let dz := pz - c.z;
    let d := Math.hypot(dx, dz);
    let minD := c.r + 0.45;
    if d < minD && d > 0.0001 && y < heightAt(c.x, c.z) + 9 then (
      px := c.x + dx / d * minD;
      pz := c.z + dz / d * minD)
  );
  let rr := Math.hypot(px, pz);
  if rr > WORLD_R then (px := px / rr * WORLD_R; pz := pz / rr * WORLD_R);
  [px, pz]

-- What Physics.step may ask about the terrain.
def WORLD := {
  ground: fun (x, z, y) => groundAt(x, z, y),
  lift: fun (x, z, y) => inUpdraft(x, z, y),
  wade: fun (x, z) => heightAt(x, z) < WATER_Y - 0.4,
  push: fun (x, z, y) => pushOut(x, z, y) }

def readInput() := {
  kx: (if keys["d"] then 1 else 0) - (if keys["a"] then 1 else 0),
  kz: (if keys["w"] then 1 else 0) - (if keys["s"] then 1 else 0),
  yaw: CAM.yaw,
  pitch: CAM.pitch,
  sprint: keys["shift"] == true,
  jump: consume(" "),
  skill: consume("e"),
  fly: consume("q"),
  rise: (if keys[" "] then 1 else 0) - (if keys["c"] then 1 else 0) }

def toast(msg) := do
  let el := byId("toast");
  setText(el, msg);
  toggleClass(el, "show", true);
  G.toastT := 2.6;
  null

-- ───────────────────────── monsters ─────────────────────────
-- The fighting rules live in Combat.leanjs as a pure `fight`; here the
-- monsters get bodies built from primitives (toon shaded and outlined
-- like the rest of the world), animated from their state each frame.

include "Combat.leanjs"

-- Where they live: [kind, x, z].
def SPAWNS := [
  ["slime", 18, 8], ["slime", 22, 13], ["slime", 14, 14],
  ["slime", -30, 42], ["slime", -35, 46],
  ["slime", 40, -10], ["slime", 45, -5], ["slime", 37, -3],
  ["wisp", -20, -8], ["wisp", -25, -13],
  ["wisp", 58, 62], ["wisp", 64, 57],
  ["wisp", 8, -78], ["wisp", 1, -83],
  ["golem", -55, -45], ["slime", -49, -39], ["slime", -60, -38],
  ["golem", 112, -6]
]

def FIGHT := {state: {hero: newHero(), foes: [], bolts: []}, rooted: false, defeated: 0, shake: 0}
def foeViews := {}

def SLIME_COLORS := [0x86e3ff, 0xa6f0a0, 0xffb3d9]

-- Two dark eyes with a white glint, looking along +z.
def eyes(parent, x, y, z, size) := do
  let dark := new THREE.MeshBasicMaterial({color: 0x1d1830});
  let glint := new THREE.MeshBasicMaterial({color: 0xffffff});
  for s in [-1, 1] do (
    let e := new THREE.Mesh(new THREE.SphereGeometry(size, 10, 8), dark);
    e.scale.set(0.8, 1.2, 0.5);
    e.position.set(s * x, y, z);
    parent.add(e);
    let g := new THREE.Mesh(new THREE.SphereGeometry(size * 0.35, 6, 4), glint);
    g.position.set(s * x + size * 0.25, y + size * 0.4, z + size * 0.4);
    parent.add(g)
  );
  null

-- Health bar: two sprites at the same point; the fill's anchor moves so
-- its left end stays on the bar's (see updateMonsters).
def hpBar(parent, y, w) := do
  let bg := new THREE.Sprite(new THREE.SpriteMaterial({color: 0x1d1830, depthTest: false, transparent: true, opacity: 0.7}));
  bg.scale.set(w + 0.08, 0.16, 1);
  bg.position.y := y;
  bg.renderOrder := 10;
  let fill := new THREE.Sprite(new THREE.SpriteMaterial({color: 0xff6b7a, depthTest: false}));
  fill.scale.set(w, 0.1, 1);
  fill.position.y := y;
  fill.renderOrder := 11;
  parent.add(bg);
  parent.add(fill);
  {bg: bg, fill: fill, w: w}

def makeSlime(id) := do
  let root := new THREE.Group();
  let body := new THREE.Group();
  let blob := outlined(new THREE.SphereGeometry(0.62, 20, 14), SLIME_COLORS[id % 3], 1.05);
  blob.scale.set(1, 0.82, 1);
  blob.position.y := 0.5;
  body.add(blob);
  eyes(body, 0.19, 0.58, 0.58, 0.075);
  let sprout := outlined(new THREE.ConeGeometry(0.09, 0.3, 6), 0x4fb35a, 1.1);
  sprout.position.y := 1.08;
  sprout.rotation.z := 0.3;
  body.add(sprout);
  root.add(body);
  {root: root, body: body, mats: [blob.children[0].material], bar: hpBar(root, 1.55, 0.9), arms: [], rings: [], tele: null}

def makeWisp(id) := do
  let root := new THREE.Group();
  let body := new THREE.Group();
  let core := new THREE.Mesh(new THREE.SphereGeometry(0.34, 16, 12),
    new THREE.MeshStandardMaterial({color: 0xd9c8ff, emissive: 0xa98bff, emissiveIntensity: 1.6}));
  body.add(core);
  eyes(body, 0.11, 0.04, 0.32, 0.05);
  let tail := new THREE.Mesh(new THREE.ConeGeometry(0.26, 0.8, 10),
    new THREE.MeshBasicMaterial({color: 0xc9b6ff, transparent: true, opacity: 0.55, depthWrite: false}));
  tail.rotation.x := PI;
  tail.position.y := -0.5;
  body.add(tail);
  let rings := [];
  for k in range(0, 2, 1) do (
    let ring := new THREE.Mesh(new THREE.TorusGeometry(0.56 + k * 0.14, 0.025, 6, 32),
      new THREE.MeshBasicMaterial({color: 0xf0e8ff, transparent: true, opacity: 0.8,
                                   blending: THREE.AdditiveBlending, depthWrite: false}));
    body.add(ring);
    push(rings, ring)
  );
  root.add(body);
  {root: root, body: body, mats: [core.material], bar: hpBar(root, 1.0, 0.8), arms: [], rings: rings, tele: null}

def makeGolem(id) := do
  let root := new THREE.Group();
  let body := new THREE.Group();
  let torso := outlined(new THREE.DodecahedronGeometry(0.95, 0), 0x9a9488, 1.04);
  torso.scale.set(1.1, 1.0, 0.85);
  torso.position.y := 1.45;
  body.add(torso);
  let head := outlined(new THREE.BoxGeometry(0.8, 0.6, 0.7), 0xa8a296, 1.05);
  head.position.y := 2.45;
  body.add(head);
  let moss := outlined(new THREE.BoxGeometry(0.86, 0.14, 0.76), 0x6cbf5f, 1.04);
  moss.position.y := 2.8;
  body.add(moss);
  let eye := new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.1, 0.05),
    new THREE.MeshStandardMaterial({color: 0x8ffcff, emissive: 0x3fe3ff, emissiveIntensity: 2.4}));
  eye.position.set(0, 2.48, 0.36);
  body.add(eye);
  for s in [-1, 1] do (
    let leg := outlined(new THREE.BoxGeometry(0.42, 0.7, 0.45), 0x8a857a, 1.05);
    leg.position.set(s * 0.42, 0.35, 0);
    body.add(leg)
  );
  let arms := [];
  for s in [-1, 1] do (
    let shoulder := new THREE.Group();
    shoulder.position.set(s * 1.15, 1.85, 0);
    let arm := outlined(new THREE.BoxGeometry(0.45, 1.3, 0.5), 0x948e82, 1.05);
    arm.position.y := -0.6;
    shoulder.add(arm);
    let fist := outlined(new THREE.DodecahedronGeometry(0.36, 0), 0x8a857a, 1.05);
    fist.position.y := -1.3;
    shoulder.add(fist);
    body.add(shoulder);
    push(arms, shoulder)
  );
  root.add(body);
  -- where the slam will land
  let tele := new THREE.Mesh(new THREE.RingGeometry(KINDS.golem.contact - 0.25, KINDS.golem.contact, 40),
    new THREE.MeshBasicMaterial({color: 0xff7a6b, transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide}));
  tele.rotation.x := -PI / 2;
  tele.position.y := 0.08;
  scene.add(tele);
  {root: root, body: body, mats: [torso.children[0].material, head.children[0].material], bar: hpBar(root, 3.3, 1.4),
   arms: arms, rings: [], tele: tele}

def buildMonsters() := do
  let mut foes := [];
  let mut id := 1;
  for s in SPAWNS do (
    let y := groundAt(s[1], s[2], 99) + (if KINDS[s[0]].fly then 2.6 else 0);
    push(foes, newFoe(id, s[0], s[1], y, s[2]));
    let view := if s[0] == "slime" then makeSlime(id) else if s[0] == "wisp" then makeWisp(id) else makeGolem(id);
    view.root.position.set(s[1], y, s[2]);
    scene.add(view.root);
    foeViews[id] := { view with flash: 0, gone: 0, seed: hash2(id, 7) * 10 };
    id := id + 1
  );
  FIGHT.state := { FIGHT.state with foes := foes };
  null

-- Each monster's body follows its state: hops, wind-ups, flashes when hit.
def updateMonsters(dt, t) := do
  for f in FIGHT.state.foes do (
    let v := foeViews[f.id];
    let K := KINDS[f.kind];
    let tt := t + v.seed;
    v.flash := Math.max(0, v.flash - dt);
    v.gone := if f.state == "dead" then Math.min(1, v.gone + dt * 4) else Math.max(0, v.gone - dt * 2);
    v.root.position.set(f.x, f.y, f.z);
    v.root.rotation.y := f.facing;
    v.root.scale.setScalar(Math.max(0.001, 1 - v.gone));
    v.root.visible := v.gone < 1;
    let wind := if f.state == "windup" then clamp(f.t / K.windup, 0, 1) else 0;
    -- body language
    if f.kind == "slime" then (
      let hop := if f.state == "chase" || f.state == "return" then Math.abs(Math.sin(tt * 9)) * 0.35
                 else if f.state == "strike" then 0.5 * Math.sin(clamp(f.t / K.strike, 0, 1) * PI) else 0;
      let sq := if f.state == "windup" then 1 - wind * 0.35 else 1 + Math.sin(tt * 4) * 0.05;
      v.body.position.y := hop;
      v.body.scale.set(1 / Math.sqrt(sq), sq, 1 / Math.sqrt(sq)))
    else if f.kind == "wisp" then (
      v.body.position.y := Math.sin(tt * 2.5) * 0.15;
      for k in range(0, v.rings.length, 1) do (
        v.rings[k].rotation.x := tt * (1.5 + k) + k;
        v.rings[k].rotation.y := tt * (0.9 + k * 0.7));
      v.body.position.x := if f.state == "windup" then Math.sin(tt * 60) * 0.05 * wind else 0;
      v.mats[0].emissiveIntensity := 1.6 + wind * 2.5)
    else (
      let lift := if f.state == "windup" then wind
                  else if f.state == "strike" then 1 - clamp(f.t / K.strike, 0, 1) else 0;
      for a in v.arms do (a.rotation.x := -lift * 2.6);
      v.body.rotation.z := if f.state == "chase" || f.state == "return" then Math.sin(tt * 5) * 0.06 else 0;
      v.tele.position.set(f.x + Math.sin(f.facing) * 0.6, f.y + 0.08, f.z + Math.cos(f.facing) * 0.6);
      v.tele.material.opacity := if f.state == "windup" then 0.25 + wind * 0.55 else 0);
    -- a white flash when hit (an emissive tint on the toon materials)
    for m in v.mats do (
      if f.kind != "wisp" then m.emissive.setScalar(v.flash * 5));
    -- the health bar shows once hurt
    let frac := f.hp / K.hp;
    let shown := f.state != "dead" && frac < 0.999;
    v.bar.bg.visible := shown;
    v.bar.fill.visible := shown;
    v.bar.fill.scale.x := Math.max(0.001, v.bar.w * frac);
    v.bar.fill.center.x := 0.5 / Math.max(0.001, frac)
  );
  null

-- Wind bolts: a glowing ball each, the pool grows as needed.
def boltMeshes := []
def BOLT_MAT := new THREE.MeshStandardMaterial({color: 0xd8fff6, emissive: 0x6effe2, emissiveIntensity: 3})

def updateBolts() := do
  let bs := FIGHT.state.bolts;
  while boltMeshes.length < bs.length do (
    let m := new THREE.Mesh(new THREE.SphereGeometry(0.22, 10, 8), BOLT_MAT);
    scene.add(m);
    push(boltMeshes, m));
  for k in range(0, boltMeshes.length, 1) do (
    let m := boltMeshes[k];
    m.visible := k < bs.length;
    if k < bs.length then (
      m.position.set(bs[k].x, bs[k].y, bs[k].z);
      emit(bs[k].x, bs[k].y, bs[k].z, 0, 0.3, 0, 0.35))
  );
  null

-- Swing arcs: a flat crescent of wind in front of her that widens and fades.
def ARC_GEO := new THREE.RingGeometry(1.2, 2.4, 32, 1, -PI * 0.45, PI * 0.9)
def arcs := []

def swingArc(p, facing, big) := do
  let mut slot := null;
  for a in arcs do (if a.life <= 0 then slot := a);
  if slot == null then (
    let m := new THREE.Mesh(ARC_GEO, new THREE.MeshBasicMaterial({color: 0xbfffee, transparent: true, opacity: 0,
                            blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide}));
    scene.add(m);
    slot := {mesh: m, life: 0, big: false};
    push(arcs, slot));
  slot.life := 0.28;
  slot.big := big;
  slot.mesh.position.set(p.x, p.y + 1.2, p.z);
  -- ring angles run from +x toward +y; lie it flat and turn it to face `facing`
  slot.mesh.rotation.set(-PI / 2, 0, facing - PI / 2);
  slot.mesh.scale.setScalar(if big then 1.3 else 1);
  null

def updateArcs(dt) := do
  for a in arcs do (
    if a.life > 0 then (
      a.life := a.life - dt;
      let k := 1 - Math.max(0, a.life) / 0.28;
      a.mesh.scale.setScalar((if a.big then 1.3 else 1) * (0.7 + k * 0.6));
      a.mesh.material.opacity := Math.max(0, 0.85 * (1 - k)))
  );
  null

-- Floating damage numbers (HTML, placed over the 3D point each frame).
def numbers := []

def popNumber(x, y, z, text, cls) := do
  let el := doc.createElement("div");
  el.className := "num " + cls;
  el.textContent := text;
  byId("fx").appendChild(el);
  push(numbers, {el: el, x: x + (Math.random() - 0.5) * 0.6, y: y, z: z, life: 0.9});
  null

def updateNumbers(dt) := do
  let w := win.innerWidth;
  let h := win.innerHeight;
  for n in numbers do (
    n.life := n.life - dt;
    n.y := n.y + dt * 1.4;
    let v := new THREE.Vector3(n.x, n.y, n.z).project(camera);
    let on := n.life > 0 && v.z < 1;
    setStyle(n.el, "opacity", (if on then "" + Math.min(1, n.life * 3) else "0"));
    setStyle(n.el, "transform", "translate(" + ((v.x * 0.5 + 0.5) * w) + "px, " + ((0.5 - v.y * 0.5) * h) + "px)");
    if n.life <= 0 then n.el.remove()
  );
  let alive := numbers.filter(fun (n) => n.life > 0);
  numbers.length := 0;
  for n in alive do (push(numbers, n));
  null

-- What a fight event looks like and sounds like on screen.
def showFightEvent(e) := do
  if e.ev == "swing" then swingArc(G.p, e.facing, e.combo == 2);
  if e.ev == "damage" then (
    popNumber(e.x, e.y, e.z, "" + e.amount, (if e.big then "big" else ""));
    burst(e.x, e.y - 0.6, e.z, (if e.big then 26 else 12), (if e.big then 6 else 4));
    let v := foeViews[e.id];
    v.flash := 0.12);
  if e.ev == "defeat" then (
    FIGHT.defeated := FIGHT.defeated + 1;
    burst(e.x, e.y, e.z, 60, 7);
    ringBurst(e.x, e.y - 0.4, e.z, 40, 5));
  if e.ev == "respawn" then (
    let f := FIGHT.state.foes.filter(fun (g) => g.id == e.id)[0];
    burst(f.x, f.y + 0.6, f.z, 20, 3));
  if e.ev == "strike" && e.kind == "golem" then (
    ringBurst(e.x, e.y, e.z, 70, 8);
    FIGHT.shake := 0.35);
  if e.ev == "bolt" then burst(e.x, e.y, e.z, 8, 2);
  if e.ev == "burst" then burst(e.x, e.y, e.z, 18, 4);
  if e.ev == "hurt" then (
    popNumber(e.x, e.y, e.z, "" + e.amount, "hurt");
    G.hurtT := 0.42;
    FIGHT.shake := Math.max(FIGHT.shake, 0.2));
  if e.ev == "down" then toast("Knocked out…");
  if e.ev == "revive" then (
    let tx := if SHRINE.attuned then SHRINE.x + 4 else 0;
    let tz := if SHRINE.attuned then SHRINE.z + 4 else 30;
    G.p := { G.p with x := tx, z := tz, y := heightAt(tx, tz) + 0.5, vx := 0, vy := 0, vz := 0,
                      gliding := false, flying := false };
    burst(tx, G.p.y + 1, tz, 60, 6);
    toast(if SHRINE.attuned then "Back at the Wind Shrine" else "Back on your feet"));
  null

-- ───────────────────────── per-frame update ─────────────────────────

def updatePlayer(dt) := do
  let inp0 := readInput();
  let down := FIGHT.state.hero.down > 0;
  -- mid-swing she stands her ground; knocked out, she does nothing at all
  let inp := if down then { inp0 with kx := 0, kz := 0, jump := false, skill := false, fly := false, rise := 0 }
             else if FIGHT.rooted then { inp0 with kx := 0, kz := 0 } else inp0;
  let r := step(G.p, inp, WORLD, dt);
  G.p := r.player;
  let f := fight(FIGHT.state, G.p, {attack: consume("attack") && !down, yaw: CAM.yaw, pitch: CAM.pitch}, r.events, WORLD, dt);
  FIGHT.state := f.state;
  FIGHT.rooted := f.rooted;
  let kn := f.knock;
  G.p := { G.p with vx := G.p.vx + kn.x, vz := G.p.vz + kn.z,
                    vy := (if kn.y > 0 then Math.max(G.p.vy, kn.y) else G.p.vy),
                    onGround := G.p.onGround && kn.y <= 0,
                    facing := (if f.face == null then G.p.facing else f.face) };
  for e in f.events do (showFightEvent(e));
  let p := G.p;
  for ev in r.events do (
    if ev == "glide" then burst(p.x, p.y + 1.4, p.z, 14, 3);
    if ev == "fly" then ringBurst(p.x, p.y, p.z, 60, 6);
    if ev == "skill" then ringBurst(p.x, p.y, p.z, 90, 9);
    if ev == "land" then burst(p.x, p.y + 0.1, p.z, 6, 2)
  );
  -- shrine: attune with F, return with T
  let ds := Math.hypot(p.x - SHRINE.x, p.z - SHRINE.z);
  setStyle(byId("prompt"), "opacity", (if ds < 6 && !SHRINE.attuned then "1" else "0"));
  if consume("f") && ds < 6 && !SHRINE.attuned then (
    SHRINE.attuned := true;
    shrineGem.material.color.set(0xffe28a);
    shrineGem.material.emissive.set(0xffb83f);
    burst(SHRINE.x, heightAt(SHRINE.x, SHRINE.z) + 6.4, SHRINE.z, 120, 9);
    toast("Wind Shrine attuned — press T to return here"));
  if consume("t") && SHRINE.attuned then (
    let tx := SHRINE.x + 4;
    let tz := SHRINE.z + 4;
    G.p := { G.p with x := tx, z := tz, y := heightAt(tx, tz) + 0.5, vy := 0, gliding := false };
    burst(tx, G.p.y + 1, tz, 60, 6));
  -- motes
  for m in motes do (
    if !m.got && Math.hypot(G.p.x - m.x, G.p.z - m.z) < 1.6 && Math.abs(G.p.y + 1 - m.y) < 2.2 then (
      m.got := true;
      m.mesh.visible := false;
      G.motes := G.motes + 1;
      burst(m.x, m.y, m.z, 70, 7);
      toast(if G.motes == motes.length then "All Breeze Motes found!"
            else "Breeze Mote " + G.motes + " / " + motes.length))
  );
  null

def animateHero(dt, t) := do
  let p := G.p;
  let moved := new THREE.Vector3(p.x, p.y, p.z).sub(hero.root.position);
  hero.root.position.set(p.x, p.y, p.z);
  let turnRate := turn(hero.root.rotation.y, p.facing) / dt;
  hero.root.rotation.y := p.facing;
  if hero.mixer then (
    let speed := Math.hypot(p.vx, p.vz);
    let fh := FIGHT.state.hero;
    G.hurtT := Math.max(0, G.hurtT - dt);
    play(if fh.down > 0 then "hurt"
         else if fh.swing >= 0 then "attack_" + (fh.combo + 1)
         else if G.hurtT > 0 && p.onGround then "hurt"
         else if p.flying then (if speed > 9 then "fly" else "hover")
         else if p.gliding then "glide"
         else if !p.onGround then "fall"
         else if speed > 0.8 then "run" else "idle");
    hero.actions["run"].timeScale := clamp(speed / 7.5, 0.75, 1.7);
    -- lean forward with speed when flying (less when climbing), bank into turns
    let lean := if p.flying then clamp((speed - 6) / 20, 0, 1) * 1.25 - clamp(p.vy / 20, -0.3, 0.4)
                else if p.gliding then 0.9 else 0;
    let bank := if p.flying || p.gliding then clamp(-turnRate * 0.15, -0.7, 0.7) else 0;
    let k := Math.min(1, 5 * dt);
    -- knocked out: she sinks to the ground on her back
    let downed := fh.down > 0;
    hero.pivot.position.y := lerp(hero.pivot.position.y, (if downed then 0.3 else HIPS * HERO_SCALE), k);
    hero.pivot.rotation.x := lerp(hero.pivot.rotation.x, (if downed then -1.45 else lean), k);
    hero.pivot.rotation.z := lerp(hero.pivot.rotation.z, bank, k);
    hero.mixer.update(dt);
    hero.root.updateMatrixWorld(true);
    updateSprings(dt, moved));
  null

def updateCamera(dt) := do
  let tx := G.p.x;
  let tz := G.p.z;
  let cp := Math.cos(CAM.pitch);
  -- pull back a little when flying fast
  let dist := CAM.dist + (if G.p.flying then Math.hypot(G.p.vx, G.p.vz) * 0.12 else 0);
  -- look at her shoulders, or at her face when zoomed right in
  let ty := G.p.y + lerp(2.0, 1.7, clamp((dist - 2.2) / 3, 0, 1));
  let wx := tx + Math.sin(CAM.yaw) * cp * dist;
  let wz := tz + Math.cos(CAM.yaw) * cp * dist;
  let wy := Math.max(ty + Math.sin(CAM.pitch) * dist, Math.max(heightAt(wx, wz), WATER_Y) + 0.8);
  let k := Math.min(1, 10 * dt);
  CAM.x := lerp(CAM.x, wx, k);
  CAM.y := lerp(CAM.y, wy, k);
  CAM.z := lerp(CAM.z, wz, k);
  FIGHT.shake := Math.max(0, FIGHT.shake - dt);
  let sh := FIGHT.shake * 0.6;
  camera.position.set(CAM.x + (Math.random() - 0.5) * sh, CAM.y + (Math.random() - 0.5) * sh, CAM.z);
  camera.lookAt(tx, ty, tz);
  sun.position.set(tx + SUN_DIR.x * 80, ty + SUN_DIR.y * 80, tz + SUN_DIR.z * 80);
  sun.target.position.set(tx, ty, tz);
  null

def updateWorld(dt, t) := do
  grassMat.uniforms.uTime.value := t;
  shrineGem.rotation.y := t * 1.2;
  shrineGem.position.y := 6.4 + Math.sin(t * 2) * 0.15;
  shrineBeam.material.opacity := if SHRINE.attuned then 0.22 + Math.sin(t * 3) * 0.06 else 0;
  for m in motes do (
    if !m.got then (
      m.mesh.position.y := m.y + Math.sin(t * 2.2 + m.x) * 0.25;
      m.mesh.rotation.y := t * 1.8;
      m.halo.rotation.x := t * 1.1;
      if Math.random() < dt * 3 then
        emit(m.x + (Math.random() - 0.5), m.y, m.z + (Math.random() - 0.5), 0, 1.2, 0, 0.9))
  );
  for c in clouds do (
    c.position.x := c.position.x + dt * 1.5;
    if c.position.x > 420 then (c.position.x := -420)
  );
  -- wind streaks around the hero while gliding or sprinting
  if (G.p.gliding || G.p.flying || Math.hypot(G.p.vx, G.p.vz) > 11) && Math.random() < dt * 30 then
    emit(G.p.x + (Math.random() - 0.5) * 3, G.p.y + Math.random() * 2, G.p.z + (Math.random() - 0.5) * 3,
         -G.p.vx * 0.3, 0.5, -G.p.vz * 0.3, 0.5);
  null

-- ───────────────────────── HUD + minimap ─────────────────────────

def MAP := { img: null, size: 160, span: 480 }

def buildMinimap() := do
  let c := doc.createElement("canvas");
  c.width := MAP.size;
  c.height := MAP.size;
  let ctx := c.getContext("2d");
  let img := ctx.createImageData(MAP.size, MAP.size);
  for py in range(0, MAP.size, 1) do (
    for px in range(0, MAP.size, 1) do (
      let x := (px / MAP.size - 0.5) * MAP.span;
      let z := (py / MAP.size - 0.5) * MAP.span;
      let y := heightAt(x, z);
      let col := if y < WATER_Y then [0.27, 0.66, 0.88] else terrainColor(x, y, z);
      let o := (py * MAP.size + px) * 4;
      img.data[o] := col[0] * 255;
      img.data[o + 1] := col[1] * 255;
      img.data[o + 2] := col[2] * 255;
      img.data[o + 3] := 255
    )
  );
  ctx.putImageData(img, 0, 0);
  MAP.img := c;
  null

def mapXY(x, z) := [(x / MAP.span + 0.5) * MAP.size, (z / MAP.span + 0.5) * MAP.size]

def drawMinimap() := do
  let cv := byId("minimap");
  let ctx := cv.getContext("2d");
  let half := cv.width / 2;
  let me := mapXY(G.p.x, G.p.z);
  let zoom := 2.2;
  ctx.save();
  ctx.clearRect(0, 0, cv.width, cv.height);
  ctx.beginPath();
  ctx.arc(half, half, half, 0, TAU);
  ctx.clip();
  ctx.translate(half, half);
  ctx.scale(zoom, zoom);
  ctx.translate(-me[0], -me[1]);
  ctx.drawImage(MAP.img, 0, 0);
  for m in motes do (
    if !m.got then (
      let p := mapXY(m.x, m.z);
      ctx.fillStyle := "#5fffe0";
      ctx.beginPath();
      ctx.arc(p[0], p[1], 1.6, 0, TAU);
      ctx.fill())
  );
  for f in FIGHT.state.foes do (
    if f.state != "dead" then (
      let q := mapXY(f.x, f.z);
      ctx.fillStyle := if f.kind == "golem" then "#ff5a4f" else "#ff8a7a";
      ctx.beginPath();
      ctx.arc(q[0], q[1], (if f.kind == "golem" then 2.2 else 1.3), 0, TAU);
      ctx.fill())
  );
  let sp := mapXY(SHRINE.x, SHRINE.z);
  ctx.fillStyle := if SHRINE.attuned then "#ffd36a" else "#e8f6ff";
  ctx.fillRect(sp[0] - 1.8, sp[1] - 1.8, 3.6, 3.6);
  ctx.restore();
  -- player arrow, always centered and pointing where the hero faces
  ctx.save();
  ctx.translate(half, half);
  ctx.rotate(PI - G.p.facing);
  ctx.fillStyle := "#ffffff";
  ctx.strokeStyle := "#26304a";
  ctx.lineWidth := 1.5;
  ctx.beginPath();
  ctx.moveTo(0, -8); ctx.lineTo(6, 6); ctx.lineTo(0, 3); ctx.lineTo(-6, 6);
  ctx.closePath();
  ctx.fill();
  ctx.stroke();
  ctx.restore();
  null

def updateHud(dt) := do
  let frac := G.p.stamina / MAX_STAMINA;
  let ring := byId("stamina-ring");
  setStyle(ring, "stroke-dashoffset", "" + (1 - frac) * 163);
  setStyle(byId("stamina"), "opacity", (if frac < 0.995 then "1" else "0"));
  toggleClass(byId("stamina"), "tired", G.p.exhausted);
  setText(byId("motes"), "" + G.motes + " / " + motes.length);
  let fh := FIGHT.state.hero;
  setStyle(byId("hp-fill"), "width", "" + fh.hp / HERO_HP * 100 + "%");
  setText(byId("hp-text"), fmt0(Math.ceil(fh.hp)) + " / " + HERO_HP);
  toggleClass(byId("hp"), "low", fh.hp < HERO_HP * 0.3);
  setText(byId("defeated"), "" + FIGHT.defeated);
  setText(byId("skill-cd"), (if G.p.skillCd > 0 then fmt0(Math.ceil(G.p.skillCd)) else ""));
  toggleClass(byId("skill"), "cooling", G.p.skillCd > 0);
  setText(byId("state"), (if G.p.flying then "Flying" else if G.p.gliding then "Gliding" else if !G.p.onGround then "Airborne" else if Math.hypot(G.p.vx, G.p.vz) > 11 then "Sprinting" else ""));
  if G.toastT > 0 then (
    G.toastT := G.toastT - dt;
    if G.toastT <= 0 then toggleClass(byId("toast"), "show", false));
  drawMinimap();
  null

-- ───────────────────────── input wiring ─────────────────────────

def setupInput() := do
  listen(win, "keydown", keyDown);
  listen(win, "keyup", keyUp);
  listen(win, "blur", fun (e) => do
    for k in Object.keys(keys) do (keys[k] := false);
    null);
  -- a click attacks: any press while the pointer is locked, otherwise a
  -- press and release without dragging the view
  listen(canvas, "mousedown", fun (e) => do
    if e.button == 0 && doc.pointerLockElement == canvas then pressed["attack"] := true;
    CAM.dragging := true;
    CAM.dragged := 0;
    lockPointer(canvas);
    toggleClass(byId("help"), "hidden", true);
    null);
  listen(win, "mouseup", fun (e) => do
    if e.button == 0 && CAM.dragging && CAM.dragged < 6 && doc.pointerLockElement != canvas then pressed["attack"] := true;
    CAM.dragging := false;
    null);
  listen(win, "mousemove", fun (e) => do
    CAM.dragged := CAM.dragged + Math.abs(e.movementX) + Math.abs(e.movementY);
    if doc.pointerLockElement == canvas || CAM.dragging then (
      CAM.yaw := CAM.yaw - e.movementX * 0.0032;
      CAM.pitch := clamp(CAM.pitch + e.movementY * 0.0026, -0.25, 1.25));
    null);
  listen(canvas, "wheel", fun (e) => do
    e.preventDefault();
    CAM.dist := clamp(CAM.dist + e.deltaY * 0.01, 2.2, 22);
    null);
  null

-- ───────────────────────── boot ─────────────────────────

def composer := new EffectComposer(renderer)
def bloom := new UnrealBloomPass(new THREE.Vector2(256, 256), 0.45, 0.4, 0.96)

def resize() := do
  let w := win.innerWidth;
  let h := win.innerHeight;
  renderer.setSize(w, h, false);
  composer.setSize(w, h);
  camera.aspect := w / h;
  camera.updateProjectionMatrix();
  null

def clock := { last: 0, fps: 60 }

def frame(ms) := do
  let t := now();
  let dt := Math.min(0.05, Math.max(0.001, t - clock.last));
  clock.last := t;
  clock.fps := lerp(clock.fps, 1 / dt, 0.05);
  updatePlayer(dt);
  animateHero(dt, t);
  updateMonsters(dt, t);
  updateBolts();
  updateArcs(dt);
  updateWorld(dt, t);
  updateUpdrafts(t);
  updateSparks(dt);
  updateCamera(dt);
  updateHud(dt);
  composer.render();
  updateNumbers(dt);
  win.__breezehollow := {x: G.p.x, y: G.p.y, z: G.p.z, stamina: G.p.stamina, gliding: G.p.gliding,
                         flying: G.p.flying, heroine: hero.mixer != null,
                         motes: G.motes, fps: clock.fps, attuned: SHRINE.attuned,
                         hp: FIGHT.state.hero.hp, defeated: FIGHT.defeated,
                         foes: FIGHT.state.foes.map(fun (f) => {kind: f.kind, state: f.state, hp: f.hp, x: f.x, z: f.z})};
  raf(frame)

def boot() := do
  setupRenderer();
  setupLights();
  buildSky();
  buildClouds();
  buildTerrain();
  buildWater();
  buildGrass(if LOW then 6000 else 70000);
  buildFlowers(if LOW then 120 else 500);
  buildForest();
  buildIslands();
  buildShrine();
  buildMotes();
  buildUpdrafts();
  buildMonsters();
  buildSparks();
  buildMinimap();
  composer.addPass(new RenderPass(scene, camera));
  if !LOW then composer.addPass(bloom);
  composer.addPass(new OutputPass());
  setupInput();
  listen(win, "resize", fun (e) => resize());
  resize();
  G.p := { G.p with y := heightAt(G.p.x, G.p.z) + 0.1 };
  clock.last := now();
  loadHeroine();
  raf(frame)

boot()
